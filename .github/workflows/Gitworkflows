name: Purge History

on:
  workflow_dispatch:  # 只允许手动点按钮触发

permissions:
  contents: write     # 允许改写仓库内容

jobs:
  clean:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0    # 拉取完整历史，否则 filter 没法工作

      - name: Install git-filter-repo
        run: pip install git-filter-repo

      - name: Remove build artifacts from history
        run: |
          git filter-repo --path-glob 'app/build/**' --invert-paths --force
          git filter-repo --path-glob '.gradle/**' --invert-paths --force

      - name: Force push
        run: git push --force origin main

