<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0D0D0D"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- Top: template format row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/tpl2x2" android:layout_width="wrap_content" android:layout_height="40dp" android:text="2×2" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl3x3" android:layout_width="wrap_content" android:layout_height="40dp" android:text="3×3" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl4x4" android:layout_width="wrap_content" android:layout_height="40dp" android:text="4×4" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl1x3" android:layout_width="wrap_content" android:layout_height="40dp" android:text="1×3" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl3x1" android:layout_width="wrap_content" android:layout_height="40dp" android:text="3×1" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl1x2" android:layout_width="wrap_content" android:layout_height="40dp" android:text="1×2" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tpl2x1" android:layout_width="wrap_content" android:layout_height="40dp" android:text="2×1" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="已选 0 张 · 2×2"
        android:textColor="#FFAAAAAA"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSelected"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:padding="4dp"
        android:background="#FF141414" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="拼图预览" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom: 清空 / 选图 / 生成 -->
    <LinearLayout
        android:id="@+id/collageBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/bg_bottom_action_bar"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="清空"
            android:layout_marginEnd="6dp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btnPick"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="选图"
            android:layout_marginEnd="6dp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="生成"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
