<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0D0D0D"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- 主区域：最终拼图预览，点文字可改 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="0dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#FF0D0D0D"
            android:contentDescription="拼图预览" />

        <LinearLayout
            android:id="@+id/editHintBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#CC000000">

            <TextView
                android:id="@+id/btnEditTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="点此改标题"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnEditReporter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="点此改汇报人"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnEditSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="点此改副标题"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:padding="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="点底部「选图」开始拼图"
            android:textColor="#FF888888"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>


    <!-- 排版预设 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/tplVertical"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="竖向"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/tpl2x2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="2×2"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/tpl3xN"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="3×N"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />
        </LinearLayout>
    </HorizontalScrollView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文字"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/seekTextScale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="40" />
        <TextView
            android:id="@+id/tvTextScale"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1.2x"
            android:textColor="#FFCCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="已选 0 张"
        android:textColor="#FFAAAAAA"
        android:textSize="12sp" />

    <!-- 底部操作：选图 / 保存 -->
    <LinearLayout
        android:id="@+id/collageBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#FF1A1A1A"
        android:elevation="0dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="清空"
            android:layout_marginEnd="6dp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btnPick"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="选图"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="保存"
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>
