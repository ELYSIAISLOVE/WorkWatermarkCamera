<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：返回 / 标题 / 照片数 -->
    <LinearLayout
        android:id="@+id/galleryTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/app_surface"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/gallery_back"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_ui_back"
        app:tint="@color/app_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="相册"
            android:textColor="@color/app_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/app_on_surface_secondary"
            android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btnColumns"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/gallery_columns"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_ui_grid"
        app:tint="@color/app_on_surface" />
    </LinearLayout>

    <!-- 搜索行 -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_gallery_search"
        android:gravity="center_vertical"
        android:hint="搜索文件名或地点"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/app_on_surface"
        android:textColorHint="@color/app_on_surface_secondary"
        android:textSize="13sp" />

    <!-- 多选操作条 -->
    <LinearLayout
        android:id="@+id/layoutSelectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface_alt"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已选 0"
            android:textColor="@color/app_on_surface"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectAll"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="全选"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnInvertSelection"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="反选"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClearSelection"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="清空"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="删除"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConfirmSelection"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="拼图"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp" />

        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.3"
        android:contentDescription="@string/gallery_empty"
        android:src="@drawable/ic_ui_gallery"
        app:tint="@color/app_on_surface_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="还没有照片"
                android:textColor="@color/app_on_surface_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="拍下的照片会按日期分组显示在这里"
                android:textColor="@color/app_on_surface_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底栏：刷新 / 多选 -->
    <LinearLayout
        android:id="@+id/galleryBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_action_bar"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btnRefresh"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="刷新"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnMultiSelect"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="多选"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
