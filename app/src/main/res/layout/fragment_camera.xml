<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ==================== Camera Preview ==================== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- ==================== Focus Frame Overlay ==================== -->
    <View
        android:id="@+id/focusFrame"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_focus_frame"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ==================== Top Control Bar ==================== -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_glass_bar"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Menu Button -->
            <ImageButton
                android:id="@+id/btnMenu"
        android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="菜单"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/white" />

            <!-- Collage Button -->
            <ImageButton
                android:id="@+id/btnCollage"
        android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_collage"
                android:src="@android:drawable/ic_menu_crop"
                app:tint="@color/white" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_title"
                android:textColor="@color/glass_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Verify Button -->
            <ImageButton
                android:id="@+id/btnVerify"
        android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_verify"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/white" />

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnSettingsTop"
        android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_settings"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@color/white" />

        </LinearLayout>

    </FrameLayout>

    <!-- ==================== Zoom Ratio Display ==================== -->
    <TextView
        android:id="@+id/tvZoomRatio"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="1.0x"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ==================== Aspect Ratio Display ==================== -->
    <TextView
        android:id="@+id/tvAspectRatio"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="4:3"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvZoomRatio"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ==================== Flash Mode Button ==================== -->
    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/flash_auto"
        android:src="@android:drawable/ic_menu_compass"
        android:visibility="gone"
        app:tint="@color/white"
        app:layout_constraintEnd_toStartOf="@id/tvEvValue"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ==================== EV Value Display ==================== -->
    <TextView
        android:id="@+id/tvEvValue"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="EV 0.0"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/tvAspectRatio"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ==================== Low Light Warning ==================== -->
    <LinearLayout
        android:id="@+id/lowLightWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/low_light_warning"
            android:textColor="@color/warning"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTurnOnFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/low_light_turn_on"
            android:textColor="@color/color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ==================== Watermark Preview Overlay ==================== -->
    <com.watermark.camera.data.watermark.WatermarkOverlayView
        android:id="@+id/watermarkOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:minWidth="168dp"
        android:minHeight="80dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent" />
    <!-- ==================== Exposure Compensation Slider ==================== -->
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderExposure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:valueFrom="-2.0"
        android:valueTo="2.0"
        android:stepSize="0.1"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:trackColorActive="@color/color_primary"
        app:trackColorInactive="@color/glass_background"
        app:thumbColor="@color/color_primary" />

    <!-- ==================== Bottom Control Bar ==================== -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_glass_bar"
        android:elevation="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Gallery Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnGallery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_gallery"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="相册"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="0dp" />

            <!-- Watermark Edit Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnWatermark"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_watermark"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="水印"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <View
                android:layout_width="32dp"
                android:layout_height="0dp" />

            <!-- Capture Button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnCapture"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_capture_button"
                    android:contentDescription="@string/btn_capture"
                    android:elevation="4dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/white" />

            </FrameLayout>

            <View
                android:layout_width="32dp"
                android:layout_height="0dp" />

            <!-- Collage Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCollageBottom"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_collage"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拼图"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="0dp" />

            <!-- Settings Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_settings"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ==================== Shutter Flash Overlay ==================== -->
    <View
        android:id="@+id/shutterFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="invisible" />

</androidx.constraintlayout.widget.ConstraintLayout>
