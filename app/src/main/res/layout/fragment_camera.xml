<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_viewer_background"
    tools:context=".ui.camera.CameraFragment">

    <!-- Theme letterbox behind preview (outside rounded content reads as black/white) -->
    <View
        android:id="@+id/letterboxMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/camera_viewer_background"
        android:clickable="false"
        android:focusable="false"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Top bar: 左侧变焦显示，右侧补光灯，不再留空 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_top_bar_solid"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 变焦显示：点击弹出楔形变焦条 / 双指捏合时实时显示 -->
        <TextView
            android:id="@+id/tvZoomRatio"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:background="@color/camera_scrim_strong"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/camera_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 补光灯开关 -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/btn_settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flash_on" />
    </LinearLayout>


    <!-- Horizontal template strip (toggle via 水印 button); height 0 when GONE via code optional -->
    <!-- legacy strip: kept GONE for binding compatibility -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/templateStrip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom bar first so preview can constrain above it -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_bottom_bar_solid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- Gallery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/btnGallery"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/btn_gallery"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gallery" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="相册"
                    android:textColor="@color/camera_on_surface_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Watermark -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/btnWatermark"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/btn_watermark"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_watermark" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="水印"
                    android:textColor="@color/camera_on_surface_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Capture -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4">
                <ImageButton
                    android:id="@+id/btnCapture"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_capture_button"
                    android:contentDescription="@string/btn_capture"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <!-- Collage -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/btnCollageBottom"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/btn_collage"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_photo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="拼图"
                    android:textColor="@color/camera_on_surface_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Settings — same structure as Gallery/Watermark/Collage -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_circle">
                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/btn_settings"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="设置"
                    android:textColor="@color/camera_on_surface_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Preview band: PreviewView + mask + watermark share IDENTICAL bounds ===== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="1dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Simple rounded frame stroke only (no design-pack chrome) -->
    <View
        android:id="@+id/previewRoundedMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:background="@drawable/bg_preview_rounded_stroke"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />


    <!-- 保存队列指示：移到画面右下角，避开默认左下水印位置 -->
    <LinearLayout
        android:id="@+id/saveQueueIndicatorRoot"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@color/camera_scrim_medium"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintVertical_bias="0.15">
        <View android:id="@+id/queueSlot9" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot8" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot7" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot6" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot5" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot4" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot3" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot2" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot1" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
        <View android:id="@+id/queueSlot0" android:layout_width="8dp" android:layout_height="10dp" android:layout_margin="1dp" android:background="@color/camera_queue_slot" />
    </LinearLayout>

<com.watermark.camera.data.watermark.WatermarkOverlayView
        android:id="@+id/watermarkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    
    <!-- Zoom chips (0.5x / 1x / 2x) — above shutter, non-blocking -->
    <LinearLayout
        android:id="@+id/zoomChipRow"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoomChip05"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="0.5"
            android:textColor="@color/camera_on_surface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomChip1x"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="1x"
            android:textColor="@color/camera_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomChip2x"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/camera_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Focus frame (centered in preview) -->
    <View
        android:id="@+id/focusFrame"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="invisible"
        android:background="@drawable/bg_preview_rounded_frame"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- 闪光灯与变焦显示已上移至 topBar；此处不再重复定义 -->

    <!-- Hidden legacy controls (keep IDs for existing Kotlin) -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnCollage"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnVerify"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnSettingsTop"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvAspectRatio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvEvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        android:id="@+id/lowLightWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <TextView
            android:id="@+id/btnTurnOnFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderExposure"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/shutterFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/camera_surface_white"
        android:visibility="invisible"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Right side settings panel -->
    <FrameLayout
        android:id="@+id/sidePanelRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/sidePanelScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/camera_scrim_strong" />

        <LinearLayout
            android:id="@+id/sidePanelSheet"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:background="@color/camera_sheet"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp">

            <!-- 顶部人物图：固定高度铺满宽度，不拉伸变形 -->
            <ImageView
                android:id="@+id/sidePanelHero"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginTop="0dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="false"
                android:src="@drawable/bg_settings_hero"
                android:contentDescription="设置页顶图" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sidePanelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="设置"
                    android:textColor="@color/camera_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="主题"
                    android:textColor="@color/camera_on_surface_tertiary"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/sideThemeAuto"
                            android:layout_width="96dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/camera_chip"
                            android:gravity="center"
                            android:text="自动"
                            android:textColor="@color/camera_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sideThemeBlack"
                            android:layout_width="96dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/camera_chip"
                            android:gravity="center"
                            android:text="黑色"
                            android:textColor="@color/camera_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sideThemeWhite"
                            android:layout_width="96dp"
                            android:layout_height="48dp"
                            android:background="@color/camera_chip"
                            android:gravity="center"
                            android:text="白色"
                            android:textColor="@color/camera_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:text="水印"
                    android:textColor="@color/camera_on_surface_tertiary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="显示地点"
                        android:textColor="@color/camera_on_surface"
                        android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sideSwitchLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="陀螺仪自适应"
                        android:textColor="@color/camera_on_surface"
                        android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sideSwitchGyro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="保持屏幕常亮"
                        android:textColor="@color/camera_on_surface"
                        android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sideSwitchKeepOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="水印位置"
                    android:textColor="@color/camera_on_surface_tertiary"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/sidePosBL" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="左下" android:textColor="@color/camera_on_surface" android:background="@color/camera_chip" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/sidePosBR" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="右下" android:textColor="@color/camera_on_surface" android:background="@color/camera_chip" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/sidePosTL" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="左上" android:textColor="@color/camera_on_surface" android:background="@color/camera_chip" android:layout_marginEnd="4dp" />
                    <TextView android:id="@+id/sidePosTR" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center" android:text="右上" android:textColor="@color/camera_on_surface" android:background="@color/camera_chip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sideAbout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingTop="16dp"
                    android:text="关于 · 工作水印相机"
                    android:textColor="@color/camera_on_surface"
                    android:textSize="15sp" />

                <!-- Keep legacy ids as gone stubs so old code does not NPE -->
                <TextView android:id="@+id/sideEv" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/sideFlash" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/sideImageSize" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/sideAntiFake" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
