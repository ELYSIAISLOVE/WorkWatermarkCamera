<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_viewer_background"
    tools:context=".ui.camera.CameraFragment">

    <!-- Theme letterbox behind preview (outside rounded content reads as black/white) -->
    <View
        android:id="@+id/letterboxMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/camera_viewer_background"
        android:clickable="false"
        android:focusable="false"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- 顶栏（规范 §4）：状态栏高 + 56dp，半透明渐变；左变焦倍数，右拼图 / 补光灯 / 设置 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar_gradient"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 变焦显示：点击弹出楔形变焦条 / 双指捏合时实时显示 -->
        <TextView
            android:id="@+id/tvZoomRatio"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@color/camera_scrim_strong"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/camera_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 拼图（从底栏上移，使底栏主次清晰） -->
        <ImageButton
            android:id="@+id/btnCollage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/btn_collage"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ui_photo"
            app:tint="@color/camera_on_surface" />

        <!-- 补光灯开关 -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/flash_toggle"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ui_flash_on"
            app:tint="@color/camera_on_surface" />

        <!-- 设置 -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/btn_settings"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ui_settings"
            app:tint="@color/camera_on_surface" />
    </LinearLayout>


    <!-- Horizontal template strip (toggle via 水印 button); height 0 when GONE via code optional -->
    <!-- legacy strip: kept GONE for binding compatibility -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/templateStrip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom bar first so preview can constrain above it -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_bottom_bar_solid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 相册入口；保存队列以角标叠加（规范 §4） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnGallery"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="@string/btn_gallery"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_ui_gallery"
                        app:tint="@color/camera_on_surface" />

                    <TextView
                        android:id="@+id/tvGalleryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/btn_gallery"
                        android:textColor="@color/camera_on_surface_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/queueBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="40dp"
                    android:background="@drawable/bg_queue_badge"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/queueBadgeProgress"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/camera_on_surface" />

                    <TextView
                        android:id="@+id/tvQueueCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/camera_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </FrameLayout>

                <View
                    android:id="@+id/vQueueFailed"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="52dp"
                    android:background="@drawable/bg_status_dot_failed"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 当前水印模板名（点击打开选择面板） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/btnWatermark"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glass_chip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:maxWidth="180dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/btn_watermark"
                    android:textColor="@color/camera_on_surface"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Capture -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4">
                <ImageButton
                    android:id="@+id/btnCapture"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_capture_button"
                    android:contentDescription="@string/btn_capture"
                    android:scaleType="centerInside" />
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ===== Preview band: PreviewView + mask + watermark share IDENTICAL bounds ===== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="1dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Simple rounded frame stroke only (no design-pack chrome) -->
    <View
        android:id="@+id/previewRoundedMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:background="@drawable/bg_preview_rounded_stroke"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />


    <!-- 保存队列已改为相册角标（规范 §4），原 14dp 细条指示器移除 -->

<com.watermark.camera.data.watermark.WatermarkOverlayView
        android:id="@+id/watermarkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    
    <!-- Zoom chips (0.5x / 1x / 2x) — above shutter, non-blocking -->
    <LinearLayout
        android:id="@+id/zoomChipRow"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoomChip05"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="0.5"
            android:textColor="@color/camera_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomChip1x"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="1x"
            android:textColor="@color/camera_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomChip2x"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/camera_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Focus frame (centered in preview) -->
    <View
        android:id="@+id/focusFrame"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="invisible"
        android:background="@drawable/bg_preview_rounded_frame"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- 闪光灯与变焦显示已上移至 topBar；此处不再重复定义 -->

    <!-- Hidden legacy controls (keep IDs for existing Kotlin) -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnCollageBottom"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnVerify"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        android:id="@+id/btnSettingsTop"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvAspectRatio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvEvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout
        android:id="@+id/lowLightWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <TextView
            android:id="@+id/btnTurnOnFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderExposure"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/shutterFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/camera_surface_white"
        android:visibility="invisible"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />


</androidx.constraintlayout.widget.ConstraintLayout>
