<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF5F5F5"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- 真实预览：由 WatermarkRenderer 直接绘制，与成片完全一致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.watermark.camera.ui.watermark.WatermarkPreviewView
            android:id="@+id/pickerPreviewCard"
            android:layout_width="0dp"
            android:layout_height="132dp"
            android:layout_weight="1"
            android:background="#FFE6E9EE" />

        <ImageButton
            android:id="@+id/pickerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="工作水印 · 左模板 / 右数字样式（可独立滑动）"
        android:textColor="#FF666666"
        android:textSize="11sp" />

    <!-- Dual pane -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerTemplateGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clipToPadding="false"
            android:padding="4dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#22000000" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerStyleList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:clipToPadding="false"
            android:padding="4dp" />
    </LinearLayout>


    <!-- 自定义水印文字（仅「自定义」模板可见） -->
    <LinearLayout
        android:id="@+id/pickerCustomTitleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义文字"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/pickerCustomTitle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#FFFFFFFF"
            android:hint="输入水印标题"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FF111111"
            android:textColorHint="#FF999999"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Transparency -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="透明度"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/pickerTransparency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="100" />

        <TextView
            android:id="@+id/pickerTransparencyValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100%"
            android:textColor="#FF333333"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 字号 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="字号"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/pickerFontScale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="270"
            android:progress="95" />

        <TextView
            android:id="@+id/pickerFontScaleValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1.25x"
            android:textColor="#FF333333"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 字体族 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="字体"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/pickerFontRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 显示开关 + 位置快捷 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <CheckBox
            android:id="@+id/pickerShowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="显示日期"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="位置"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/pickerPositionRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 字段显隐（按当前模板动态生成） -->
    <LinearLayout
        android:id="@+id/pickerFieldToggles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />
</LinearLayout>
