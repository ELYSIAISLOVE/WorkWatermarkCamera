         DayNight 切换时界面颜色完全不变。现在统一走语义色。 -->
    <color name="app_background">#FFF5F7FA</color>
    <color name="app_surface">#FFFFFFFF</color>
    <color name="app_surface_alt">#FFEEF1F5</color>
