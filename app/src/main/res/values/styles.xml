<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设置页排版（规范 §7：4dp 栅格、四档字号） -->
    <style name="SettingsGroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/app_on_surface_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/app_on_surface_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:background">@color/app_divider</item>
    </style>
</resources>